{{template "head" (dict "Title" "Laporan")}}
{{$job := .Job}}
{{$r := .Report}}

<section class="card">
  <div class="report-head">
    <div>
      <h1>Laporan perbandingan</h1>
      <p class="lede">{{$job.PrevName}} → {{$job.CurrName}}</p>
    </div>
    <div class="report-actions">
      <a class="btn" href="/jobs/{{$job.ID}}/export.json">Ekspor JSON</a>
      <a class="btn btn-quiet" href="/">Bandingkan lagi</a>
    </div>
  </div>

  <div class="stats">
    <div class="stat"><span class="n">{{$r.Summary.Total}}</span><span class="k">perubahan teks</span></div>
    <div class="stat"><span class="n">{{$r.PrevArticleCount}} → {{$r.CurrArticleCount}}</span><span class="k">jumlah pasal</span></div>
    <div class="stat"><span class="n sev-critical">{{$r.Summary.Critical}}</span><span class="k">kritis</span></div>
    <div class="stat"><span class="n sev-major">{{$r.Summary.Major}}</span><span class="k">mayor</span></div>
    <div class="stat"><span class="n sev-minor">{{$r.Summary.Minor}}</span><span class="k">minor</span></div>
    <div class="stat"><span class="n">{{dur $job.Duration}}</span><span class="k">durasi</span></div>
  </div>

  <p class="class-summary">
    <span class="badge badge-verified">{{$r.Summary.Verified}} terverifikasi</span>
    <span class="badge badge-advisory">{{$r.Summary.Advisory}} saran AI</span>
    {{if not $job.UseAI}}<span class="hint">— lapisan AI tidak dijalankan untuk perbandingan ini.</span>{{end}}
  </p>
</section>

{{if $r.Findings}}
<section class="card">
  <h2>Temuan</h2>
  {{range $r.Findings}}
    <article class="finding {{severityClass .Severity}}">
      <header>
        <span class="sev">{{.Severity}}</span>
        <span class="badge {{classBadge .Class}}">
          {{if eq (printf "%s" .Class) "advisory"}}saran AI{{else}}terverifikasi{{end}}
        </span>
        <span class="cat">{{.Category}}</span>
        {{if and (eq (printf "%s" .Class) "advisory") .Confidence}}
          <span class="conf" title="keyakinan model">{{pct .Confidence}}</span>
        {{end}}
      </header>

      <p class="msg">{{.Message}}</p>

      <p class="loc">
        {{if .ParaIndex}}<span>paragraf [{{.ParaIndex}}] ({{sideLabel .Side}})</span>{{end}}
        {{if .NodeID}}<span>{{.NodeID}}</span>{{end}}
      </p>

      {{range .Evidence}}<p class="evidence">{{.}}</p>{{end}}

      {{range .Actions}}
        <div class="action action-{{.Type}}">
          <span class="action-type">{{.Type}}</span>
          {{if eq (printf "%s" .Type) "manual_review"}}
            <span>{{.Rationale}}</span>
          {{else}}
            <span class="old">{{.Old}}</span>
            <span class="arrow">→</span>
            <span class="new">{{.New}}</span>
            {{if .Rationale}}<span class="why">{{.Rationale}}</span>{{end}}
          {{end}}
        </div>
      {{end}}
    </article>
  {{end}}
</section>
{{else}}
<section class="card">
  <h2>Temuan</h2>
  <p class="ok-big">Tidak ada masalah penomoran atau rujukan silang.</p>
</section>
{{end}}

{{if $r.Changes}}
<section class="card">
  <h2>Perubahan teks ({{len $r.Changes}})</h2>
  {{range $r.Changes}}
    <article class="change {{if .Cosmetic}}cosmetic{{end}}">
      <header>
        <span class="ctype">{{.Type}}</span>
        {{if .Cosmetic}}<span class="chip">kosmetik</span>{{end}}
        {{if .Context}}<span class="cctx">{{.Context}}</span>{{end}}
      </header>
      {{if .PrevHTML}}<p class="side prev">{{highlight .PrevHTML}}</p>{{end}}
      {{if .CurrHTML}}<p class="side curr">{{highlight .CurrHTML}}</p>{{end}}
    </article>
  {{end}}
</section>
{{end}}

{{if $job.Usage}}
<section class="card">
  <h2>Biaya token</h2>
  <table class="usage">
    <thead>
      <tr><th>node</th><th>model</th><th class="num">call</th><th class="num">input</th>
          <th class="num">cache read</th><th class="num">output</th><th class="num">USD</th></tr>
    </thead>
    <tbody>
      {{range $job.Usage}}
      <tr>
        <td>{{.Node}}</td><td class="mono">{{.Model}}</td>
        <td class="num">{{.Calls}}</td><td class="num">{{.Input}}</td>
        <td class="num">{{.CacheRead}}</td><td class="num">{{.Output}}</td>
        <td class="num">{{usd .USD}}</td>
      </tr>
      {{end}}
    </tbody>
    <tfoot>
      <tr><td colspan="6">Total</td><td class="num">{{usd $job.CostUSD}}</td></tr>
    </tfoot>
  </table>
  <p class="hint">
    Kolom <em>cache read</em> harus &gt; 0 pada perbandingan kedua dan seterusnya.
    Kalau selalu nol, prefix prompt berubah antar permintaan dan asumsi biaya
    tidak berlaku.
  </p>
</section>
{{end}}

{{template "foot"}}
