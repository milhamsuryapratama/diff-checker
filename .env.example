# Salin berkas ini menjadi .env dan isi sesuai kebutuhan:
#   cp .env.example .env
#
# diff-checker berjalan penuh TANPA berkas .env sama sekali — seluruh
# pemeriksaan penomoran dan referensi silang (mesin deterministik) tidak
# butuh API key. Variabel di bawah ini hanya relevan kalau kamu ingin
# mengaktifkan lapisan AI (--ai di CLI, atau checkbox "Analisis AI" di UI).

# --- Server (cmd/server) ---------------------------------------------------

# Alamat listen HTTP.
# ADDR=:8080

# Direktori penyimpanan berkas yang diunggah. Kosongkan untuk memakai
# direktori sementara (default) — dihapus otomatis saat server berhenti.
# UPLOAD_DIR=

# Jumlah perbandingan yang boleh berjalan bersamaan.
# WORKER_CONCURRENCY=2

# --- Lapisan AI: kredensial provider ---------------------------------------

# Dibutuhkan hanya jika ada tier yang memakai provider "anthropic"
# (default untuk semua tier: triage/analyze/recommend/adjudicate).
ANTHROPIC_API_KEY=

# Dibutuhkan hanya jika kamu mengarahkan provider ke "openai" atau endpoint
# OpenAI-compatible lain (DeepSeek, Qwen, GLM, dst. lewat DIFF_BASE_URL).
OPENAI_API_KEY=

# --- Lapisan AI: override model per tier (opsional) ------------------------
#
# Tier yang tersedia: TRIAGE, ANALYZE, RECOMMEND, ADJUDICATE.
# Default masing-masing: Haiku 4.5 / Sonnet 5 / Opus 5 / Opus 5 (lihat
# internal/agentic/models/registry.go).
#
# Variabel tanpa akhiran tier berlaku untuk SEMUA tier sekaligus; variabel
# dengan akhiran _<TIER> menimpanya hanya untuk tier itu.

# DIFF_PROVIDER=anthropic          # anthropic | openai — berlaku untuk semua tier
# DIFF_MODEL=claude-sonnet-5       # berlaku untuk semua tier
# DIFF_BASE_URL=                   # endpoint kustom, mis. untuk gateway OpenAI-compatible

# DIFF_PROVIDER_TRIAGE=
# DIFF_MODEL_TRIAGE=
# DIFF_BASE_URL_TRIAGE=
# DIFF_RATE_IN_TRIAGE=             # USD per juta token input, untuk laporan biaya
# DIFF_RATE_OUT_TRIAGE=            # USD per juta token output

# DIFF_PROVIDER_ANALYZE=
# DIFF_MODEL_ANALYZE=
# DIFF_BASE_URL_ANALYZE=
# DIFF_RATE_IN_ANALYZE=
# DIFF_RATE_OUT_ANALYZE=

# DIFF_PROVIDER_RECOMMEND=
# DIFF_MODEL_RECOMMEND=
# DIFF_BASE_URL_RECOMMEND=
# DIFF_RATE_IN_RECOMMEND=
# DIFF_RATE_OUT_RECOMMEND=

# DIFF_PROVIDER_ADJUDICATE=
# DIFF_MODEL_ADJUDICATE=
# DIFF_BASE_URL_ADJUDICATE=
# DIFF_RATE_IN_ADJUDICATE=
# DIFF_RATE_OUT_ADJUDICATE=

# --- Contoh: arahkan semua tier ke DeepSeek lewat endpoint OpenAI-compatible
# DIFF_PROVIDER=openai
# DIFF_MODEL=deepseek-chat
# DIFF_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-...
